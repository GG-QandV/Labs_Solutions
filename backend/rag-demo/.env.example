GEMINI_API_KEY=
RESEND_API_KEY=
OPSHUB_KEY=
# optional: LLM_PROVIDER=zen (opencode zen, MiMo V2.5 Free) disables OCR (no vision)
OPENCODE_ZEN_API_KEY=
# optional: LLM_MODEL=mimo-v2.5-free, LLM_BASE_URL=https://opencode.ai/zen/v1

# ---- models & retrieval (single source of truth, audit F2) ----
# embedder: granite-embedding-97m-r2 (SELECTED) | multilingual-e5-small (rollback)
EMBED_MODEL=granite-embedding-r2
# pooling: first (<|startoftext|>, Granite) | mean (e5 rollback requires mean + prefixed=1)
EMBED_POOLING=first
# 1 = prepend query:/passage: prefixes (rollback for e5-small only)
EMBED_PREFIXED=0
# reranker: gte-multilingual-reranker-base (SELECTED) | tinybert-rerank (rollback)
RERANK_MODEL=gte-reranker
EMBED_DIM=384
COSINE_THRESHOLD=0.55
# informational (soft filter disabled until RERANK_THRESHOLD_LOOSE is set)
RERANK_THRESHOLD=-4.0
# empty = rerank soft-filter OFF; set after G4 logit measurement (Task 7)
RERANK_THRESHOLD_LOOSE=
CHUNK_TOKENS=420

# ---- trap logs (audit F8) ----
TRAP_LOGS=1
# error | warning | info | debug — прод: warning (only bugs/warnings in OpsHub)
TRAP_LEVEL=warning

# --- dispatcher demo ---
# Copy to .env on the VPS (chmod 600). Never commit the real file.

# Gemini — request classification
GEMINI_API_KEY=

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Seed admin (demo credentials shown on the landing demo page)
SEED_ADMIN_EMAIL=demo@labs.mnemostroma.com
SEED_ADMIN_PASSWORD=

# Telegram intake (optional; leave empty to disable the webhook route)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# OpsHub fleet key (same value as the other demos)
OPSHUB_KEY=

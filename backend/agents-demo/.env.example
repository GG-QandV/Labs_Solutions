# Живой прогон. Без ключа демо работает в режиме кэша — это штатно.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LIVE_RUNS_PER_DAY_PER_IP=3

# Темп воспроизведения: >1 быстрее, <1 медленнее.
SPEED=1.0
GATE_TIMEOUT_SEC=300

# OpsHub (в парке заполняется из .env парка)
OPSHUB_URL=http://opshub:8700
OPSHUB_KEY=
OPSHUB_SERVICE=agents-demo
GATE_PING_SEC=15
